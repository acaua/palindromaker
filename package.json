  "dependencies": {
    "@heroicons/react": "^1.0.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "slate": "^0.63.0",
    "slate-history": "^0.62.0",
    "slate-react": "^0.65.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.2.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "husky": "^6.0.0",
    "lint-staged": "^11.0.0",
    "postcss": "^8.3.5",
    "prettier": "3.9.6",
    "tailwindcss": "^2.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,css,md}": "prettier --write",
