{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palindromaker",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "build": {
    // `pnpm check` is `vp check && vp test run` (format, lint, type
    // checks, then the unit tests); `vp check` alone runs no tests, so
    // spelling out the script is what keeps a failing test from deploying.
    "command": "pnpm check && vp build",
  },
}
